const { ContainerBuilder, TextDisplayBuilder, SectionBuilder, ThumbnailBuilder, SeparatorBuilder, SeparatorSpacingSize, MessageFlags } = require("discord.js");
const { getTrophyEmoji, getVoteEmoji, getArrowEmoji, getTickEmoji, getCrossEmoji } = require("../utils/votingHelper");

async function updateLeaderboard(client, guild) {
    const guildId = guild.id;
    const leaderboardChanId = client.lmdbGet(`voting_leaderboard_channel_${guildId}`);
    if (!leaderboardChanId) return;

    const channel = guild.channels.cache.get(leaderboardChanId) || 
                    await guild.channels.fetch(leaderboardChanId).catch(() => null);
    if (!channel) return;

    // Get all active voting cards
    const cards = client.lmdbGet(`voting_cards_${guildId}`) || [];
    if (cards.length === 0) return;

    // Map cards to include vote count
    const standings = cards.map(card => {
        const voters = client.lmdbGet(`votes_${guildId}_${card.messageId}`) || [];
        return {
            ...card,
            votes: voters.length
        };
    });

    // Sort by vote count descending
    standings.sort((a, b) => b.votes - a.votes);

    // Build leaderboard display text
    const trophyEmoji = getTrophyEmoji(client, guildId);
    let leaderboardContent = `## ${trophyEmoji} PFP Event Leaderboard\n`;

    const medalEmojis = ["🥇", "🥈", "🥉"];
    standings.forEach((entry, idx) => {
        const rank = idx + 1;
        const medal = rank <= 3 ? medalEmojis[idx] : `🔹 \`#${rank}\``;
        leaderboardContent += `> ${medal} **${entry.teamName}** — **${entry.votes}** vote(s)\n`;
    });

    leaderboardContent += `\n-# Last Updated: <t:${Math.floor(Date.now() / 1000)}:R>`;

    const container = new ContainerBuilder()
        .setAccentColor(0x26272F)
        .addTextDisplayComponents(
            new TextDisplayBuilder().setContent(leaderboardContent)
        );

    // Check if we have an existing leaderboard message
    const msgId = client.lmdbGet(`voting_leaderboard_msg_${guildId}`);
    let existingMsg = null;
    if (msgId) {
        existingMsg = await channel.messages.fetch(msgId).catch(() => null);
    }

    if (existingMsg) {
        await existingMsg.edit({
            components: [container],
            flags: MessageFlags.IsComponentsV2
        }).catch(() => {});
    } else {
        const newMsg = await channel.send({
            components: [container],
            flags: MessageFlags.IsComponentsV2
        }).catch(() => null);
        if (newMsg) {
            client.lmdbSet(`voting_leaderboard_msg_${guildId}`, newMsg.id);
        }
    }
}

module.exports = (client) => {
    client.on("messageReactionRemove", async (reaction, user) => {
        if (user.bot || !reaction.message.guild) return;

        const guildId = reaction.message.guild.id;
        const messageId = reaction.message.id;

        const isCard = client.lmdbGet(`voting_card_${guildId}_${messageId}`);
        if (!isCard) return;

        if (reaction.partial) {
            try {
                await reaction.fetch();
            } catch (err) {
                console.error("Failed to fetch partial reaction:", err);
                return;
            }
        }

        const configuredEmoji = getVoteEmoji(client, guildId);

        const isEmojiMatch = (reactionEmoji, configuredEmoji) => {
            if (!configuredEmoji) return false;
            const customEmojiMatch = configuredEmoji.match(/:(\d+)>$/) || configuredEmoji.match(/^(\d+)$/);
            if (customEmojiMatch) {
                return reactionEmoji.id === customEmojiMatch[1];
            }
            return reactionEmoji.name === configuredEmoji;
        };

        if (!isEmojiMatch(reaction.emoji, configuredEmoji)) return;

        const voteKey = `votes_${guildId}_${messageId}`;
        let voters = client.lmdbGet(voteKey) || [];

        if (voters.includes(user.id)) {
            voters = voters.filter(id => id !== user.id);
            client.lmdbSet(voteKey, voters);

            const logsId = client.lmdbGet(`voting_logs_channel_${guildId}`) || 
                           client.lmdbGet(`logging_cfg_${guildId}`)?.voting;
            const logsChan = client.channels.cache.get(logsId) || 
                             await client.channels.fetch(logsId).catch(() => null);
            if (logsChan) {
                const avatarUrl = user.displayAvatarURL({ size: 256 });
                const container = new ContainerBuilder()
                    .setAccentColor(0xE74C3C)
                    .addSectionComponents(
                        new SectionBuilder()
                            .addTextDisplayComponents(
                                new TextDisplayBuilder().setContent(`## ➖ Vote Retracted`)
                            )
                            .setThumbnailAccessory(new ThumbnailBuilder().setURL(avatarUrl))
                    )
                    .addSeparatorComponents(new SeparatorBuilder().setDivider(true).setSpacing(SeparatorSpacingSize.Small))
                    .addTextDisplayComponents(
                        new TextDisplayBuilder().setContent(
                            `> **Voter:** ${user} (\`${user.tag}\` / \`${user.id}\`)\n` +
                            `> **Removed Vote From:** **${isCard.teamName}**\n` +
                            `> **Target Member:** <@${isCard.userId}>\n` +
                            `> **Timestamp:** <t:${Math.floor(Date.now() / 1000)}:T> (<t:${Math.floor(Date.now() / 1000)}:R>)`
                        )
                    );

                await logsChan.send({
                    components: [container],
                    flags: MessageFlags.IsComponentsV2
                }).catch(() => {});
            }

            // Do not await updateLeaderboard to make reaction response instant and smooth
            updateLeaderboard(client, reaction.message.guild).catch(console.error);
        }
    });
};

module.exports.updateLeaderboard = updateLeaderboard;
