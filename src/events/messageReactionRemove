const { ContainerBuilder, TextDisplayBuilder, SectionBuilder, ThumbnailBuilder, SeparatorBuilder, SeparatorSpacingSize, MessageFlags } = require("discord.js");
const { getTrophyEmoji, getVoteEmoji, getArrowEmoji, getTickEmoji, getCrossEmoji } = require("../utils/votingHelper");

const activeUpdates = new Map(); // guildId -> { isRunning: boolean, pendingUpdate: boolean }
const mongoWriteQueues = new Map(); // key -> Promise

function queueMongoWrite(client, key, value) {
    let queue = mongoWriteQueues.get(key) || Promise.resolve();
    queue = queue.then(async () => {
        await client.db.set(key, value);
    }).catch(err => {
        console.error(`MongoDB write error for key ${key}:`, err);
    });
    mongoWriteQueues.set(key, queue);
    
    // Cleanup queue when done to avoid memory leaks
    queue.finally(() => {
        if (mongoWriteQueues.get(key) === queue) {
            mongoWriteQueues.delete(key);
        }
    });
}

async function scheduleLeaderboardUpdate(client, guild) {
    const guildId = guild.id;
    let state = activeUpdates.get(guildId);
    if (!state) {
        state = { isRunning: false, pendingUpdate: false };
        activeUpdates.set(guildId, state);
    }

    if (state.isRunning) {
        state.pendingUpdate = true;
        return;
    }

    state.isRunning = true;
    try {
        await updateLeaderboard(client, guild);
    } catch (err) {
        console.error("Error updating leaderboard:", err);
    } finally {
        state.isRunning = false;
        if (state.pendingUpdate) {
            state.pendingUpdate = false;
            // Wait 2 seconds before running the pending update to throttle API calls
            setTimeout(() => scheduleLeaderboardUpdate(client, guild), 2000);
        }
    }
}

async function updateLeaderboard(client, guild) {
    const guildId = guild.id;
    
    // Fetch leaderboard channel from LMDB (fallback to DB)
    let leaderboardChanId = client.lmdbGet(`voting_leaderboard_channel_${guildId}`);
    if (!leaderboardChanId) {
        leaderboardChanId = await client.db.get(`voting_leaderboard_channel_${guildId}`);
        if (leaderboardChanId) {
            client.lmdb.putSync(`voting_leaderboard_channel_${guildId}`, leaderboardChanId);
        }
    }
    if (!leaderboardChanId) return;

    const channel = guild.channels.cache.get(leaderboardChanId) || 
                    await guild.channels.fetch(leaderboardChanId).catch(() => null);
    if (!channel) return;

    // Get all active voting cards from LMDB (fallback to DB)
    let cards = client.lmdbGet(`voting_cards_${guildId}`);
    if (!cards) {
        cards = await client.db.get(`voting_cards_${guildId}`);
        if (cards) {
            client.lmdb.putSync(`voting_cards_${guildId}`, cards);
        }
    }
    cards = cards || [];
    if (cards.length === 0) return;

    // Map cards to include vote count from LMDB (fallback to DB)
    const standings = await Promise.all(cards.map(async card => {
        let voters = client.lmdbGet(`votes_${guildId}_${card.messageId}`);
        if (!voters) {
            voters = await client.db.get(`votes_${guildId}_${card.messageId}`);
            if (voters) {
                client.lmdb.putSync(`votes_${guildId}_${card.messageId}`, voters);
            }
        }
        voters = voters || [];
        return {
            ...card,
            votes: voters.length
        };
    }));

    // Sort by vote count descending
    standings.sort((a, b) => b.votes - a.votes);

    // Build leaderboard display text
    const trophyEmoji = getTrophyEmoji(client, guildId);
    let leaderboardContent = `## ${trophyEmoji} PFP Event Leaderboard\n`;

    const medalEmojis = ["🥇", "🥈", "🥉"];
    standings.forEach((entry, idx) => {
        const rank = idx + 1;
        const medal = rank <= 3 ? medalEmojis[idx] : `🔹 \`#${rank}\``;
        leaderboardContent += `> ${medal} **${entry.teamName}** — **${entry.votes}** vote(s)\n`;
    });

    leaderboardContent += `\n-# Last Updated: <t:${Math.floor(Date.now() / 1000)}:R>`;

    const container = new ContainerBuilder()
        .setAccentColor(0x26272F)
        .addTextDisplayComponents(
            new TextDisplayBuilder().setContent(leaderboardContent)
        );

    // Check if we have an existing leaderboard message in LMDB (fallback to DB)
    let msgId = client.lmdbGet(`voting_leaderboard_msg_${guildId}`);
    if (!msgId) {
        msgId = await client.db.get(`voting_leaderboard_msg_${guildId}`);
        if (msgId) {
            client.lmdb.putSync(`voting_leaderboard_msg_${guildId}`, msgId);
        }
    }

    let existingMsg = null;
    if (msgId) {
        existingMsg = await channel.messages.fetch(msgId).catch(() => null);
    }

    if (existingMsg) {
        await existingMsg.edit({
            components: [container],
            flags: MessageFlags.IsComponentsV2
        }).catch(() => {});
    } else {
        const newMsg = await channel.send({
            components: [container],
            flags: MessageFlags.IsComponentsV2
        }).catch(() => null);
        if (newMsg) {
            client.lmdbSet(`voting_leaderboard_msg_${guildId}`, newMsg.id);
        }
    }
}

module.exports = (client) => {
    client.on("messageReactionRemove", async (reaction, user) => {
        if (reaction.message.partial) {
            try {
                await reaction.message.fetch();
            } catch (err) {
                console.error("Failed to fetch partial message in messageReactionRemove:", err);
                return;
            }
        }

        if (user.bot || !reaction.message.guild) return;

        const guild = reaction.message.guild;
        const guildId = guild.id;
        const messageId = reaction.message.id;

        // Fetch card metadata from LMDB (fallback to MongoDB)
        let isCard = client.lmdbGet(`voting_card_${guildId}_${messageId}`);
        if (!isCard) {
            isCard = await client.db.get(`voting_card_${guildId}_${messageId}`);
            if (isCard) {
                client.lmdb.putSync(`voting_card_${guildId}_${messageId}`, isCard);
            }
        }
        if (!isCard) return;

        // Fetch user if partial
        let voter = user;
        if (voter.partial) {
            try {
                voter = await client.users.fetch(voter.id);
            } catch (err) {
                console.error("Failed to fetch partial user in messageReactionRemove:", err);
            }
        }

        const configuredEmoji = getVoteEmoji(client, guildId);

        const isEmojiMatch = (reactionEmoji, configuredEmoji) => {
            if (!configuredEmoji) return false;
            const customEmojiMatch = configuredEmoji.match(/:(\d+)>$/) || configuredEmoji.match(/^(\d+)$/);
            if (customEmojiMatch) {
                return reactionEmoji.id === customEmojiMatch[1];
            }
            return reactionEmoji.name === configuredEmoji;
        };

        if (!isEmojiMatch(reaction.emoji, configuredEmoji)) return;

        const voteKey = `votes_${guildId}_${messageId}`;
        
        // Fetch voters synchronously from LMDB
        let voters = client.lmdbGet(voteKey) || [];

        if (voters.includes(voter.id)) {
            voters = voters.filter(id => id !== voter.id);
            // Remove their voting record so they can vote for another card
            client.lmdbDel(`voter_record_${guildId}_${voter.id}`);
            // Write to LMDB synchronously to prevent race conditions
            client.lmdb.putSync(voteKey, voters);
            // Sync to MongoDB sequentially in the background to prevent out-of-order writes
            queueMongoWrite(client, voteKey, voters);

            const logsId = client.lmdbGet(`voting_logs_channel_${guildId}`) || 
                           client.lmdbGet(`logging_cfg_${guildId}`)?.voting;
            const logsChan = client.channels.cache.get(logsId) || 
                             await client.channels.fetch(logsId).catch(() => null);
            if (logsChan) {
                let avatarUrl;
                try {
                    avatarUrl = voter.displayAvatarURL({ size: 256 });
                } catch {
                    avatarUrl = voter.defaultAvatarURL;
                }
                const container = new ContainerBuilder()
                    .setAccentColor(0xE74C3C)
                    .addSectionComponents(
                        new SectionBuilder()
                            .addTextDisplayComponents(
                                new TextDisplayBuilder().setContent(`## ➖ Vote Retracted`)
                            )
                            .setThumbnailAccessory(new ThumbnailBuilder().setURL(avatarUrl))
                    )
                    .addSeparatorComponents(new SeparatorBuilder().setDivider(true).setSpacing(SeparatorSpacingSize.Small))
                    .addTextDisplayComponents(
                        new TextDisplayBuilder().setContent(
                            `> **Voter:** ${voter} (\`${voter.tag || voter.id}\` / \`${voter.id}\`)\n` +
                            `> **Removed Vote From:** **${isCard.teamName}**\n` +
                            `> **Target Member:** <@${isCard.userId}>\n` +
                            `> **Timestamp:** <t:${Math.floor(Date.now() / 1000)}:T> (<t:${Math.floor(Date.now() / 1000)}:R>)`
                        )
                    );

                await logsChan.send({
                    components: [container],
                    flags: MessageFlags.IsComponentsV2
                }).catch(() => {});
            }

            // Do not await scheduleLeaderboardUpdate to make reaction response instant and smooth
            scheduleLeaderboardUpdate(client, guild).catch(console.error);
        }
    });
};

module.exports.updateLeaderboard = updateLeaderboard;
module.exports.scheduleLeaderboardUpdate = scheduleLeaderboardUpdate;
